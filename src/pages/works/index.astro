---
import Layout from '../../layouts/Layout.astro';
import { works, mediumDisplay, mediumList } from '../../data/works';

const mediumCounts = works.flatMap(w => mediumList(w.medium)).reduce<Record<string, number>>((acc, m) => {
  acc[m] = (acc[m] ?? 0) + 1;
  return acc;
}, {});
const mediums = ['All', ...Object.keys(mediumCounts).sort((a, b) => mediumCounts[b] - mediumCounts[a])];
---

<Layout title="Works — Stevie" description="A selection of works by Stevie.">
  <div class="container">
    <div class="page-header">
      <h1 class="page-title">Works</h1>
    </div>

    <!-- Filter bar -->
    <div class="filter-bar" role="group" aria-label="Filter by medium">
      {mediums.map(m => (
        <button class="filter-btn" class:list={[{ active: m === 'All' }]} data-filter={m}>
          {m}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="works-grid" id="works-grid">
      {works.map((work, i) => (
        <a
          href={`/works/${work.slug}`}
          class="work-card"
          data-mediums={mediumList(work.medium).join(',')}
        >
          <div class="work-image">
            <img
              src={work.image}
              alt={work.title}
              loading={i < 4 ? 'eager' : 'lazy'}
              onerror="this.src='/placeholder.svg'"
            />
          </div>
          <span class="work-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="work-title">{work.title}</span>
          <span class="work-meta">{work.year} — {mediumDisplay(work.medium)}</span>
          {work.dimensions && <span class="work-meta">{work.dimensions}</span>}
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }
  .filter-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .filter-btn:hover,
  .filter-btn.active {
    border-color: var(--fg);
    color: var(--fg);
  }
  .filter-btn.active {
    border-color: var(--accent);
    color: var(--accent);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .work-card.hidden { display: none; }

  @media (max-width: 768px) {
    .works-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .works-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.work-card[data-mediums]');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      cards.forEach(card => {
        const cardMediums = card.dataset.mediums?.split(',') ?? [];
        const show = filter === 'All' || cardMediums.includes(filter!);
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
