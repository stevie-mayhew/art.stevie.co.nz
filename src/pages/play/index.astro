---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/play';

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title="Play — Stevie" description="Process notes, experiments, and things that don't fit anywhere else.">
  <div class="container">
    <div class="page-header">
      <h1 class="page-title">Play</h1>
      <p class="page-subtitle">Process notes, experiments, and things that don't fit anywhere else.</p>
    </div>

    <div class="posts-list">
      {posts.map((post, i) => (
        <a href={`/play/${post.slug}`} class="post-card">
          <div class="post-cover">
            <img
              src={post.coverImage}
              alt={post.title}
              loading={i === 0 ? 'eager' : 'lazy'}
              onerror="this.src='/placeholder.svg'"
            />
          </div>
          <div class="post-info">
            <span class="post-date">{formatDate(post.date)}</span>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-excerpt">{post.excerpt}</p>
            <span class="post-read">Read more &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-subtitle {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.75rem;
    letter-spacing: 0.03em;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
  }
  .post-card:first-child { border-top: none; }
  .post-card:hover { background: var(--card-bg); }

  .post-cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--card-bg);
  }
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .post-card:hover .post-cover img { transform: scale(1.03); }

  .post-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 3.5rem;
  }

  .post-date {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .post-excerpt {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 42ch;
  }

  .post-read {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
  }
  .post-card:hover .post-read { color: var(--fg); }

  @media (max-width: 768px) {
    .post-card { grid-template-columns: 1fr; }
    .post-cover { aspect-ratio: 16 / 9; }
    .post-info { padding: 1.75rem 0; }
  }
</style>
