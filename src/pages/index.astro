---
import Layout from '../layouts/Layout.astro';
import { works, mediumDisplay } from '../data/works';

const featured = works.filter(w => w.featured).slice(0, 3);
const hero = featured[0];
---

<Layout title="Stevie Mayhew — Artist" description="Mixed media artist based in Auckland, New Zealand.">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-image">
      <img
        src={hero.image}
        alt={hero.title}
        onerror="this.src='/placeholder.svg'"
      />
      <div class="hero-caption">{hero.title}, {hero.year} — {mediumDisplay(hero.medium)}</div>
      <svg class="hero-wave-overlay" aria-hidden="true" viewBox="0 0 50 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path class="hero-wave-path" d="M22,0 C42,25 8,50 28,75 C48,100 12,125 32,150 C52,175 22,190 22,200 L50,200 L50,0 Z"/>
      </svg>
    </div>
    <div class="hero-text">
      <span class="hero-tag">Artist</span>
      <h1 class="hero-name">Stevie</h1>
      <p class="hero-location">Auckland &middot; New Zealand</p>
      <a href="/works" class="hero-cta">View Works <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <!-- Wave divider -->
  <div class="wave-sep" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 70" preserveAspectRatio="none">
      <path d="M0,35 C180,70 360,0 540,35 C720,70 900,0 1080,35 C1260,70 1380,10 1440,35 L1440,70 L0,70 Z" fill="rgba(255,255,255,0.04)"/>
    </svg>
  </div>

  <!-- Selected Works -->
  <section class="selected">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Selected Works</h2>
        <a href="/works" class="section-link">All works &rarr;</a>
      </div>
      <div class="selected-grid">
        {featured.map((work, i) => (
          <a href={`/works/${work.slug}`} class="work-card">
            <div class="work-image">
              <img
                src={work.image}
                alt={work.title}
                loading="lazy"
                onerror="this.src='/placeholder.svg'"
              />
            </div>
            <span class="work-num">0{i + 1}</span>
            <span class="work-title">{work.title}</span>
            <span class="work-meta">{work.year} — {mediumDisplay(work.medium)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* === Hero === */
  .hero {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 0;
    min-height: calc(100vh - 65px);
    overflow: hidden;
  }

  .hero-image {
    position: relative;
    background: var(--bg);
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-wave-overlay {
    position: absolute;
    top: 0;
    right: 0;
    width: 15%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .hero-wave-path {
    fill: var(--bg);
    animation: heroWave 5s ease-in-out infinite;
  }
  @keyframes heroWave {
    0%, 100% {
      d: path("M22,0 C42,25 8,50 28,75 C48,100 12,125 32,150 C52,175 22,190 22,200 L58,200 L58,0 Z");
    }
    50% {
      d: path("M26,0 C6,25 40,50 20,75 C0,100 36,125 16,150 C-4,175 26,190 26,200 L58,200 L58,0 Z");
    }
  }
  .hero-caption {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .hero-caption {
      background: rgba(0, 0, 0, 0.45);
      padding: 0.35rem 0.6rem;
      color: var(--fg);
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 3.5rem;
  }

  .hero-tag {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 14rem);
    line-height: 0.85;
    letter-spacing: 0.04em;
    font-weight: 400;
    margin-bottom: 3rem;
  }
  .hero-location {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 3rem;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    border-bottom: 1px solid var(--fg);
    padding-bottom: 0.25rem;
    width: fit-content;
    animation: float 3.5s ease-in-out infinite;
  }
  .hero-cta:hover { opacity: 0.7; }

  .wave-sep {
    display: block;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    margin-bottom: -1px;
  }
  .wave-sep svg { display: block; width: 100%; height: 70px; }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .hero-image { aspect-ratio: 4/3; }
    .hero-wave-overlay { display: none; }
    .hero-text { padding: 2.5rem 1.5rem; }
    .hero-name { font-size: clamp(3.5rem, 15vw, 6rem); }
  }

  /* === Selected Works === */
  .selected { padding: 5rem 0; }

  .selected-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .selected-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .selected-grid { grid-template-columns: 1fr; }
    .selected { padding: 3rem 0; }
  }

  /* === CTA band === */
  .cta-band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 3rem 0;
    margin-bottom: -6rem;
  }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    letter-spacing: 0.05em;
  }
  .cta-btn {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    border: 1px solid var(--fg);
    padding: 0.8rem 1.5rem;
    transition: background 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .cta-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  @media (max-width: 640px) {
    .cta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
